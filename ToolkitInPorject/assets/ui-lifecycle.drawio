<mxfile host="Electron" version="21.0.0">
  <diagram id="ui-lifecycle" name="UI生命周期状态图">
    <mxGraphModel dx="1200" dy="800" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" pageWidth="900" pageHeight="500" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <!-- Title -->
        <mxCell id="title" value="IUIForm 生命周期状态图" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontSize=15;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="150" y="20" width="500" height="30" as="geometry" />
        </mxCell>

        <!-- State: 未创建 -->
        <mxCell id="s1" value="未创建" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontColor=#333333;fontSize=13;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="40" y="200" width="120" height="50" as="geometry" />
        </mxCell>

        <!-- State: 已初始化（缓存中） -->
        <mxCell id="s2" value="已初始化&#xa;（缓存中）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=13;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="290" y="200" width="140" height="50" as="geometry" />
        </mxCell>

        <!-- State: 激活 / 可见 -->
        <mxCell id="s3" value="激活 / 可见" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=13;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="560" y="200" width="130" height="50" as="geometry" />
        </mxCell>

        <!-- State: 已销毁 -->
        <mxCell id="s4" value="已销毁" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=13;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="290" y="370" width="140" height="50" as="geometry" />
        </mxCell>

        <!-- Edge: 未创建 → 已初始化  (首次打开 / OnInit) -->
        <mxCell id="e1" value="首次打开 / OnInit" style="edgeStyle=orthogonalEdgeStyle;html=1;fontSize=11;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" source="s1" target="s2" parent="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- Edge: 已初始化 → 激活  (OpenUIForm / OnOpen) -->
        <mxCell id="e2" value="OpenUIForm / OnOpen" style="edgeStyle=orthogonalEdgeStyle;html=1;fontSize=11;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" source="s2" target="s3" parent="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- Edge: 激活 → 已初始化  (CloseUIForm / OnClose) — 从上方绕回 -->
        <mxCell id="e3" value="CloseUIForm / OnClose" style="edgeStyle=orthogonalEdgeStyle;html=1;fontSize=11;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" source="s3" target="s2" parent="1">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="625" y="120" />
              <mxPoint x="360" y="120" />
            </Array>
          </mxGeometry>
        </mxCell>

        <!-- Edge: 已初始化 → 已销毁  (ClearCache / OnRecycle) -->
        <mxCell id="e4" value="ClearCache / OnRecycle" style="edgeStyle=orthogonalEdgeStyle;html=1;fontSize=11;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" source="s2" target="s4" parent="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
