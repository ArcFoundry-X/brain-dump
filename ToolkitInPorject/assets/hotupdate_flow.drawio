<mxfile host="Electron" version="21.0.0">
  <diagram id="flow-diagram" name="热更新三步流程">
    <mxGraphModel dx="1200" dy="800" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" pageWidth="900" pageHeight="700" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <!-- Title -->
        <mxCell id="t1" value="YooAsset 热更新三步流程（HostPlayMode）" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontSize=15;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="80" y="15" width="480" height="30" as="geometry" />
        </mxCell>

        <!-- Column headers -->
        <mxCell id="ch1" value="客户端" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontSize=13;fontStyle=1;fontColor=#23527c;" vertex="1" parent="1">
          <mxGeometry x="100" y="55" width="200" height="28" as="geometry" />
        </mxCell>
        <mxCell id="ch2" value="CDN 服务器" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontSize=13;fontStyle=1;fontColor=#7d4e00;" vertex="1" parent="1">
          <mxGeometry x="400" y="55" width="180" height="28" as="geometry" />
        </mxCell>

        <!-- Divider line -->
        <mxCell id="div" value="" style="endArrow=none;strokeColor=#cccccc;strokeWidth=1;dashed=1;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="320" y="50" as="sourcePoint" />
            <mxPoint x="320" y="620" as="targetPoint" />
          </mxGeometry>
        </mxCell>

        <!-- ===== Step 1 ===== -->
        <mxCell id="s1_label" value="Step 1" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=11;fontColor=#888888;fontStyle=2;" vertex="1" parent="1">
          <mxGeometry x="20" y="95" width="55" height="20" as="geometry" />
        </mxCell>

        <mxCell id="s1_client" value="&lt;b&gt;RequestPackageVersionAsync&lt;/b&gt;&#xa;请求最新版本号" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;align=center;" vertex="1" parent="1">
          <mxGeometry x="80" y="90" width="210" height="55" as="geometry" />
        </mxCell>

        <!-- Request arrow → -->
        <mxCell id="s1_req" value="GET version.json" style="endArrow=open;endFill=0;strokeColor=#6c8ebf;fontColor=#6c8ebf;fontSize=10;dashed=1;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="290" y="117" as="sourcePoint" />
            <mxPoint x="390" y="117" as="targetPoint" />
          </mxGeometry>
        </mxCell>

        <mxCell id="s1_cdn" value="返回版本号&#xa;&lt;b&gt;&quot;1.0.3&quot;&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;align=center;" vertex="1" parent="1">
          <mxGeometry x="390" y="90" width="175" height="55" as="geometry" />
        </mxCell>

        <!-- Response arrow ← -->
        <mxCell id="s1_res" value="PackageVersion" style="endArrow=open;endFill=0;strokeColor=#d6b656;fontColor=#d6b656;fontSize=10;dashed=1;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" source="s1_cdn" target="s1_client" parent="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- Arrow down -->
        <mxCell id="a1" value="" style="endArrow=block;endFill=1;strokeColor=#555555;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="185" y="148" as="sourcePoint" />
            <mxPoint x="185" y="188" as="targetPoint" />
          </mxGeometry>
        </mxCell>

        <!-- ===== Step 2 ===== -->
        <mxCell id="s2_label" value="Step 2" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=11;fontColor=#888888;fontStyle=2;" vertex="1" parent="1">
          <mxGeometry x="20" y="193" width="55" height="20" as="geometry" />
        </mxCell>

        <mxCell id="s2_client" value="&lt;b&gt;LoadPackageManifestAsync&lt;/b&gt;&#xa;用版本号换资源清单" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;align=center;" vertex="1" parent="1">
          <mxGeometry x="80" y="188" width="210" height="55" as="geometry" />
        </mxCell>

        <!-- Request arrow → -->
        <mxCell id="s2_req" value="GET manifest_1.0.3.json" style="endArrow=open;endFill=0;strokeColor=#6c8ebf;fontColor=#6c8ebf;fontSize=10;dashed=1;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="290" y="215" as="sourcePoint" />
            <mxPoint x="390" y="215" as="targetPoint" />
          </mxGeometry>
        </mxCell>

        <mxCell id="s2_cdn" value="返回资源清单&#xa;&lt;b&gt;manifest.json&lt;/b&gt;&#xa;（路径 / Hash / Bundle 映射）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;align=center;" vertex="1" parent="1">
          <mxGeometry x="390" y="188" width="175" height="55" as="geometry" />
        </mxCell>

        <!-- Response arrow ← -->
        <mxCell id="s2_res" value="Manifest" style="endArrow=open;endFill=0;strokeColor=#d6b656;fontColor=#d6b656;fontSize=10;dashed=1;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" source="s2_cdn" target="s2_client" parent="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- Arrow down -->
        <mxCell id="a2" value="" style="endArrow=block;endFill=1;strokeColor=#555555;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="185" y="246" as="sourcePoint" />
            <mxPoint x="185" y="286" as="targetPoint" />
          </mxGeometry>
        </mxCell>

        <!-- ===== Step 3 ===== -->
        <mxCell id="s3_label" value="Step 3" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=11;fontColor=#888888;fontStyle=2;" vertex="1" parent="1">
          <mxGeometry x="20" y="291" width="55" height="20" as="geometry" />
        </mxCell>

        <mxCell id="s3_client" value="&lt;b&gt;CreateResourceDownloader&lt;/b&gt;&#xa;对比本地缓存与清单差异" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;align=center;" vertex="1" parent="1">
          <mxGeometry x="80" y="286" width="210" height="55" as="geometry" />
        </mxCell>

        <!-- Decision diamond -->
        <mxCell id="dec" value="TotalDownloadCount == 0 ?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="90" y="365" width="190" height="70" as="geometry" />
        </mxCell>

        <!-- Arrow: Step3 → Decision -->
        <mxCell id="a3" value="" style="endArrow=block;endFill=1;strokeColor=#555555;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="185" y="344" as="sourcePoint" />
            <mxPoint x="185" y="363" as="targetPoint" />
          </mxGeometry>
        </mxCell>

        <!-- Yes → NeedUpdate=false -->
        <mxCell id="no_update" value="NeedUpdate = false&#xa;无需下载" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="390" y="376" width="160" height="48" as="geometry" />
        </mxCell>
        <mxCell id="a_yes" value="是" style="endArrow=block;endFill=1;strokeColor=#82b366;fontColor=#82b366;fontSize=11;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="280" y="400" as="sourcePoint" />
            <mxPoint x="388" y="400" as="targetPoint" />
          </mxGeometry>
        </mxCell>

        <!-- No → Download -->
        <mxCell id="s3_dl" value="&lt;b&gt;StartDownload()&lt;/b&gt;&#xa;下载变更的 Bundle 文件" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;align=center;" vertex="1" parent="1">
          <mxGeometry x="80" y="462" width="210" height="55" as="geometry" />
        </mxCell>

        <!-- Arrow: decision→ download (No) -->
        <mxCell id="a_no" value="否" style="endArrow=block;endFill=1;strokeColor=#555555;fontColor=#555555;fontSize=11;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="185" y="437" as="sourcePoint" />
            <mxPoint x="185" y="460" as="targetPoint" />
          </mxGeometry>
        </mxCell>

        <!-- Download arrow → CDN -->
        <mxCell id="s3_req" value="GET *.bundle" style="endArrow=open;endFill=0;strokeColor=#6c8ebf;fontColor=#6c8ebf;fontSize=10;dashed=1;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="290" y="489" as="sourcePoint" />
            <mxPoint x="390" y="489" as="targetPoint" />
          </mxGeometry>
        </mxCell>

        <mxCell id="s3_cdn" value="返回变更的&#xa;Bundle 文件" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;align=center;" vertex="1" parent="1">
          <mxGeometry x="390" y="462" width="175" height="55" as="geometry" />
        </mxCell>

        <!-- Arrow: download → Done -->
        <mxCell id="a4" value="" style="endArrow=block;endFill=1;strokeColor=#555555;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="185" y="520" as="sourcePoint" />
            <mxPoint x="185" y="558" as="targetPoint" />
          </mxGeometry>
        </mxCell>

        <!-- Done -->
        <mxCell id="done" value="热更完成&#xa;OnCompleted" style="ellipse;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=13;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="105" y="558" width="160" height="55" as="geometry" />
        </mxCell>

        <!-- Note -->
        <mxCell id="note" value="YooAsset 的 Bundle 缓存机制保证幂等性：网络中断后重试不会重复下载已完成文件" style="text;html=1;strokeColor=none;fillColor=#f5f5f5;strokeColor=#666666;align=center;verticalAlign=middle;fontSize=11;fontColor=#333333;rounded=1;" vertex="1" parent="1">
          <mxGeometry x="40" y="632" width="560" height="32" as="geometry" />
        </mxCell>

      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
