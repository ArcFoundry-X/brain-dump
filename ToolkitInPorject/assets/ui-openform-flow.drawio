<mxfile host="Electron" version="21.0.0">
  <diagram id="ui-openform" name="OpenUIForm 执行流程">
    <mxGraphModel dx="1200" dy="800" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" pageWidth="780" pageHeight="820" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <!-- Title -->
        <mxCell id="title" value="OpenUIForm 执行流程" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontSize=15;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="140" y="15" width="320" height="30" as="geometry" />
        </mxCell>

        <!-- Start -->
        <mxCell id="n0" value="调用 OpenUIForm" style="ellipse;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontColor=#333333;fontSize=12;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="170" y="60" width="160" height="44" as="geometry" />
        </mxCell>

        <!-- Decision 1 -->
        <mxCell id="d1" value="已在 _activeForms？" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="155" y="140" width="190" height="60" as="geometry" />
        </mxCell>

        <!-- D1 Yes: OnOpen 刷新 -->
        <mxCell id="n1" value="OnOpen（刷新数据）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="430" y="148" width="160" height="44" as="geometry" />
        </mxCell>

        <!-- D1 Yes: 返回 -->
        <mxCell id="end1" value="返回" style="ellipse;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="460" y="230" width="100" height="40" as="geometry" />
        </mxCell>

        <!-- Decision 2 -->
        <mxCell id="d2" value="已在 _cachedForms？" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="155" y="250" width="190" height="60" as="geometry" />
        </mxCell>

        <!-- 首次：加载实例化 -->
        <mxCell id="n2" value="Resources.Load&#xa;Instantiate&#xa;OnInit&#xa;加入 _cachedForms" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="170" y="360" width="160" height="80" as="geometry" />
        </mxCell>

        <!-- 合并点：SetActive -->
        <mxCell id="n3" value="SetActive(true)&#xa;加入 _activeForms" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="170" y="490" width="160" height="50" as="geometry" />
        </mxCell>

        <!-- OnOpen -->
        <mxCell id="n4" value="OnOpen" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="170" y="580" width="160" height="44" as="geometry" />
        </mxCell>

        <!-- End -->
        <mxCell id="end2" value="结束" style="ellipse;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="200" y="664" width="100" height="40" as="geometry" />
        </mxCell>

        <!-- Edges -->
        <!-- 开始 → D1 -->
        <mxCell id="e0" value="" style="edgeStyle=orthogonalEdgeStyle;html=1;" edge="1" source="n0" target="d1" parent="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- D1 Yes → n1 -->
        <mxCell id="e1" value="是" style="edgeStyle=orthogonalEdgeStyle;html=1;fontSize=11;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" source="d1" target="n1" parent="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- n1 → end1 -->
        <mxCell id="e1b" value="" style="edgeStyle=orthogonalEdgeStyle;html=1;" edge="1" source="n1" target="end1" parent="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- D1 No → D2 -->
        <mxCell id="e2" value="否" style="edgeStyle=orthogonalEdgeStyle;html=1;fontSize=11;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" source="d1" target="d2" parent="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- D2 No → n2 -->
        <mxCell id="e3" value="否" style="edgeStyle=orthogonalEdgeStyle;html=1;fontSize=11;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" source="d2" target="n2" parent="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- D2 Yes → n3 (从右侧绕下) -->
        <mxCell id="e4" value="是" style="edgeStyle=orthogonalEdgeStyle;html=1;fontSize=11;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" source="d2" target="n3" parent="1">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="420" y="280" />
              <mxPoint x="420" y="515" />
            </Array>
          </mxGeometry>
        </mxCell>

        <!-- n2 → n3 -->
        <mxCell id="e5" value="" style="edgeStyle=orthogonalEdgeStyle;html=1;" edge="1" source="n2" target="n3" parent="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- n3 → n4 -->
        <mxCell id="e6" value="" style="edgeStyle=orthogonalEdgeStyle;html=1;" edge="1" source="n3" target="n4" parent="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- n4 → end2 -->
        <mxCell id="e7" value="" style="edgeStyle=orthogonalEdgeStyle;html=1;" edge="1" source="n4" target="end2" parent="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
