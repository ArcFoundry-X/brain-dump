<mxfile host="Electron" version="21.0.0">
  <diagram id="mvvm-dataflow" name="MVVM 数据流向">
    <mxGraphModel dx="1200" dy="800" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" pageWidth="900" pageHeight="560" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <!-- Title -->
        <mxCell id="title" value="MVVM 数据流向" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontSize=15;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="260" y="15" width="280" height="30" as="geometry" />
        </mxCell>

        <!-- Layer labels -->
        <mxCell id="lb1" value="View 层" style="text;html=1;strokeColor=none;fillColor=none;align=center;fontSize=12;fontStyle=1;fontColor=#1a6c1a;" vertex="1" parent="1">
          <mxGeometry x="60" y="55" width="140" height="25" as="geometry" />
        </mxCell>
        <mxCell id="lb2" value="ViewModel 层" style="text;html=1;strokeColor=none;fillColor=none;align=center;fontSize=12;fontStyle=1;fontColor=#23527c;" vertex="1" parent="1">
          <mxGeometry x="330" y="55" width="140" height="25" as="geometry" />
        </mxCell>
        <mxCell id="lb3" value="Model 层" style="text;html=1;strokeColor=none;fillColor=none;align=center;fontSize=12;fontStyle=1;fontColor=#7d4e00;" vertex="1" parent="1">
          <mxGeometry x="600" y="55" width="140" height="25" as="geometry" />
        </mxCell>

        <!-- View Box -->
        <mxCell id="view" value="CharacterPanelForm&#xa;&#xa;_hpBar, _hpText, _goldText&#xa;Subscribe(ViewModel)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="40" y="190" width="180" height="90" as="geometry" />
        </mxCell>

        <!-- ViewModel Box -->
        <mxCell id="vm" value="CharacterViewModel&#xa;&#xa;HpRatio (ReadOnly)&#xa;HpText (ReadOnly)&#xa;GoldText (ReadOnly)&#xa;Buy(cost)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="310" y="160" width="180" height="140" as="geometry" />
        </mxCell>

        <!-- Model Box -->
        <mxCell id="model" value="CharacterModel&#xa;&#xa;Hp (ReactiveProperty)&#xa;Gold (ReactiveProperty)&#xa;TakeDamage()&#xa;TrySpend()" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d6b656;fontSize=12;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="580" y="160" width="180" height="140" as="geometry" />
        </mxCell>

        <!-- 用户操作 -->
        <mxCell id="user" value="用户点击按钮" style="ellipse;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontColor=#333333;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="65" y="370" width="130" height="50" as="geometry" />
        </mxCell>

        <!-- 战斗系统 -->
        <mxCell id="battle" value="战斗系统&#xa;model.TakeDamage()" style="ellipse;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontColor=#333333;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="590" y="370" width="160" height="50" as="geometry" />
        </mxCell>

        <!-- Edge: View → ViewModel (用户输入，调用方法) -->
        <mxCell id="e1" value="viewModel.Buy()" style="edgeStyle=orthogonalEdgeStyle;html=1;fontSize=11;fontColor=#c00000;strokeColor=#c00000;exitX=1;exitY=0.3;exitDx=0;exitDy=0;entryX=0;entryY=0.3;entryDx=0;entryDy=0;" edge="1" source="view" target="vm" parent="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- Edge: ViewModel → Model (调用方法) -->
        <mxCell id="e2" value="TrySpend()" style="edgeStyle=orthogonalEdgeStyle;html=1;fontSize=11;fontColor=#c00000;strokeColor=#c00000;exitX=1;exitY=0.3;exitDx=0;exitDy=0;entryX=0;entryY=0.3;entryDx=0;entryDy=0;" edge="1" source="vm" target="model" parent="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- Edge: Model → ViewModel (ReactiveProperty 触发) -->
        <mxCell id="e3" value="ReactiveProperty 触发" style="edgeStyle=orthogonalEdgeStyle;html=1;fontSize=11;fontColor=#0070c0;strokeColor=#0070c0;exitX=0;exitY=0.7;exitDx=0;exitDy=0;entryX=1;entryY=0.7;entryDx=0;entryDy=0;" edge="1" source="model" target="vm" parent="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- Edge: ViewModel → View (Subscribe 自动刷新) -->
        <mxCell id="e4" value="Subscribe 自动刷新" style="edgeStyle=orthogonalEdgeStyle;html=1;fontSize=11;fontColor=#0070c0;strokeColor=#0070c0;exitX=0;exitY=0.7;exitDx=0;exitDy=0;entryX=1;entryY=0.7;entryDx=0;entryDy=0;" edge="1" source="vm" target="view" parent="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- Edge: 用户 → View -->
        <mxCell id="e5" value="" style="edgeStyle=orthogonalEdgeStyle;html=1;fontSize=11;strokeColor=#666666;" edge="1" source="user" target="view" parent="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- Edge: 战斗系统 → Model -->
        <mxCell id="e6" value="" style="edgeStyle=orthogonalEdgeStyle;html=1;fontSize=11;strokeColor=#666666;" edge="1" source="battle" target="model" parent="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- Legend -->
        <mxCell id="leg1" value="" style="endArrow=block;endFill=1;strokeColor=#c00000;html=1;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="60" y="500" as="sourcePoint" />
            <mxPoint x="120" y="500" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="leg1t" value="用户输入 / 方法调用" style="text;html=1;strokeColor=none;fillColor=none;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="130" y="490" width="160" height="22" as="geometry" />
        </mxCell>
        <mxCell id="leg2" value="" style="endArrow=block;endFill=1;strokeColor=#0070c0;html=1;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="380" y="500" as="sourcePoint" />
            <mxPoint x="440" y="500" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="leg2t" value="数据变化 / 自动响应" style="text;html=1;strokeColor=none;fillColor=none;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="450" y="490" width="160" height="22" as="geometry" />
        </mxCell>

      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
